{% from "partials/subscribe.njk" import subscribeForm %}
{% set s = cms.site %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ pageTitle or "The CEO Channel — Sharpening your game" }}</title>
  <meta name="description" content="{{ pageDescription or 'Interviews, insights and industry opinions for the people who run companies. The CEO Channel.' }}" />
  {% if pageImage %}<meta property="og:image" content="{{ pageImage }}" />{% endif %}
  {% if noIndex == "true" %}<meta name="robots" content="noindex, nofollow" />{% endif %}

  <!-- Google Fonts: Newsreader (display) + Inter (body/UI) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:wght@500;600&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="/styles.css" />
  {% if s.searchEnabled %}<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />{% endif %}
</head>
<body>

  <!-- ============================================================
       MENU BAR — navy. Logo (or the words, until a logo is
       uploaded), the sections switched on in “Sections & menu”,
       then SUBSCRIBE and search. No drop-downs.
       ============================================================ -->
  <header class="nav" id="nav">
    <div class="nav__inner">
      <a class="nav__wordmark" href="/">
        {% if s.logo %}<img class="nav__logo" src="{{ s.logo }}" alt="The CEO Channel" />{% else %}The CEO Channel{% endif %}
      </a>

      <button class="nav__toggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links">
        <span></span><span></span><span></span>
      </button>

      <nav class="nav__links" id="nav-links" aria-label="Sections">
        {% for section in cms.menu %}<a class="nav__link" href="{{ section.url }}">{{ section.name }}</a>{% endfor %}
      </nav>

      <button class="nav__subscribe" type="button" data-open="subscribe-dialog">Subscribe</button>

      {% if s.searchEnabled %}
      <button class="nav__search" type="button" aria-label="Search" data-open="search-dialog">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6">
          <circle cx="11" cy="11" r="7" />
          <line x1="16.5" y1="16.5" x2="21" y2="21" />
        </svg>
      </button>
      {% endif %}
    </div>
  </header>

  <main id="top">
{{ content | safe }}
  </main>

  <!-- ============================================================
       FOOTER — contact details come from “Site settings”.
       Empty social links hide their icon.
       ============================================================ -->
  <footer class="footer" id="footer">
    <div class="wrap">
      <div class="footer__top">
        <div>
          <a class="nav__wordmark footer__wordmark" href="/">The CEO Channel</a>
          <p class="footer__about">{{ s.tagline }}</p>
          <div class="footer__social">
            {% if s.linkedin %}<a href="{{ s.linkedin }}" aria-label="LinkedIn"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1-.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21H19v-5.3c0-1.27-.02-2.9-1.77-2.9-1.77 0-2.04 1.38-2.04 2.8V21H9z"/></svg></a>{% endif %}
            {% if s.instagram %}<a href="{{ s.instagram }}" aria-label="Instagram"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>{% endif %}
            {% if s.youtube %}<a href="{{ s.youtube }}" aria-label="YouTube"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8zM9.75 15.02V8.98L15.5 12z"/></svg></a>{% endif %}
            {% if s.x %}<a href="{{ s.x }}" aria-label="X"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M18.9 3H22l-7.1 8.1L23 21h-6.6l-5.2-6.8L5.2 21H2l7.6-8.7L1.5 3h6.8l4.7 6.2zm-1.1 16.2h1.7L7.3 4.7H5.5z"/></svg></a>{% endif %}
          </div>
        </div>

        <div class="footer__col">
          <h2>Sections</h2>
          <ul>
            {% for section in cms.menu %}<li><a href="{{ section.url }}">{{ section.name }}</a></li>{% endfor %}
          </ul>
        </div>

        <div class="footer__col">
          <h2>The CEO Channel</h2>
          <ul>
            <li><a href="#">About us</a></li>
            <li><a href="#">Partner with us</a></li>
            <li><a href="#" data-open="subscribe-dialog">Newsletter</a></li>
          </ul>
        </div>

        <div class="footer__col">
          <h2>Contact</h2>
          <ul>
            {% if s.editorialEmail %}<li>Editorial: <a href="mailto:{{ s.editorialEmail }}">{{ s.editorialEmail }}</a></li>{% endif %}
            {% if s.partnershipsEmail %}<li>Partnerships: <a href="mailto:{{ s.partnershipsEmail }}">{{ s.partnershipsEmail }}</a></li>{% endif %}
            {% if s.generalEmail %}<li>General: <a href="mailto:{{ s.generalEmail }}">{{ s.generalEmail }}</a></li>{% endif %}
          </ul>
        </div>
      </div>

      <div class="footer__bottom">
        <span>© 2026 The CEO Channel. All rights reserved.</span>
        <span><a href="/privacy/">Privacy policy</a> · <a href="#">Terms</a></span>
      </div>
    </div>
  </footer>

  <!-- ============================================================
       SUBSCRIBE POP-UP — opened by the SUBSCRIBE button
       ============================================================ -->
  <dialog class="modal" id="subscribe-dialog" aria-labelledby="subscribe-title">
    <button class="modal__close" type="button" data-close aria-label="Close">×</button>
    <h2 class="modal__title" id="subscribe-title">Sharpen your game</h2>
    <p class="modal__text">Subscribe to our newsletter for the latest interviews, insights and industry opinions delivered straight to your inbox.</p>
    {{ subscribeForm(s, "popup") }}
  </dialog>

  {% if s.searchEnabled %}
  <!-- SEARCH — results come from the site's own search index -->
  <dialog class="modal modal--search" id="search-dialog" aria-label="Search">
    <button class="modal__close" type="button" data-close aria-label="Close">×</button>
    <div id="search"></div>
  </dialog>
  <script src="/pagefind/pagefind-ui.js"></script>
  {% endif %}

  <script src="/site.js"></script>
</body>
</html>
