---
layout: layouts/base.njk
pagination:
  data: cms.everything
  size: 1
  alias: a
permalink: "{% if a.isDraft %}/preview/{{ a.slug }}/index.html{% else %}/articles/{{ a.slug }}/index.html{% endif %}"
eleventyComputed:
  pageTitle: "{% if a.isDraft %}PREVIEW · {% endif %}{{ a.seo.title or a.title }} — The CEO Channel"
  pageDescription: "{{ a.seo.description or a.excerpt }}"
  pageImage: "{{ a.image }}"
  noIndex: "{{ a.isDraft }}"
---
{#
  ARTICLE PAGE — one page for every article in the editor.
  Published articles live at /articles/<name>/.
  Drafts are built at /preview/<name>/ so Jamie can check them; that
  address isn't linked anywhere, isn't searchable and tells Google
  to stay away.
  Photo positions are decided in _data/cms.js (buildBody) and match
  the help text on each photo box in the editor.
#}
{% from "partials/subscribe.njk" import subscribeForm %}
{% macro figure(p) %}
<figure class="photo">
  <img src="{{ p.src }}" alt="{{ p.alt }}" style="object-position: {{ p.position }}" loading="lazy" referrerpolicy="no-referrer" />
  {% if p.caption or p.credit %}<figcaption>{{ p.caption }}{% if p.credit %} (Photo: {{ p.credit }}){% endif %}</figcaption>{% endif %}
</figure>
{% endmacro %}

    {% if a.isDraft %}
    <p class="preview-banner">Preview — this article is a draft and is not on the website yet. Switch Draft off in the editor and press Save to publish.</p>
    {% endif %}

    <article {% if not a.isDraft %}data-pagefind-body{% endif %}>
      <!-- ARTICLE HEADER — centred, as wide as the main photo -->
      <header class="article__head">
        <p class="{{ 'sponsored' if a.sponsored else 'tag' }}">{{ a.label }}</p>
        <h1 class="article__headline">{{ a.title }}</h1>
        <p class="article__standfirst">{{ a.excerpt }}</p>

        <div class="article__byline" data-pagefind-ignore>
          {% if a.authorInfo %}<p>By <strong>{{ a.authorInfo.name }}</strong></p>{% endif %}
          <p>Published <time datetime="{{ a.publishedDate }}">{{ a.publishedText }}</time>
            {% if a.updatedText %}&nbsp;·&nbsp; Updated <time datetime="{{ a.updatedDate }}">{{ a.updatedText }}</time>{% endif %}</p>

          <!-- Share bar, in each network's own colour. Links filled in by site.js -->
          <div class="share">
            <a class="share__btn share__btn--whatsapp" data-share="whatsapp" href="#" target="_blank" rel="noopener" aria-label="Share on WhatsApp"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3a.4.4 0 0 0 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 2.9 2.9 0 0 0-.9 2.2 5 5 0 0 0 1 2.7 11.5 11.5 0 0 0 4.4 3.9c1.6.7 2.3.8 3.1.6a2.6 2.6 0 0 0 1.7-1.2 2.1 2.1 0 0 0 .2-1.2c-.1-.1-.2-.2-.5-.3z"/></svg></a>
            <a class="share__btn share__btn--telegram" data-share="telegram" href="#" target="_blank" rel="noopener" aria-label="Share on Telegram"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M21.9 4.3 18.7 19.4c-.2 1-.9 1.3-1.8.8l-4.8-3.6-2.3 2.2c-.3.3-.5.5-1 .5l.3-4.9 8.9-8c.4-.3-.1-.5-.6-.2L6.4 13.1l-4.7-1.5c-1-.3-1-1 .2-1.5L20.5 3c.9-.3 1.6.2 1.4 1.3z"/></svg></a>
            <a class="share__btn share__btn--facebook" data-share="facebook" href="#" target="_blank" rel="noopener" aria-label="Share on Facebook"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M14 8V6.2c0-.8.2-1.2 1.4-1.2H17V2h-2.6C11.3 2 10 3.5 10 6v2H8v3h2v11h4V11h2.7l.3-3z"/></svg></a>
            <a class="share__btn share__btn--linkedin" data-share="linkedin" href="#" target="_blank" rel="noopener" aria-label="Share on LinkedIn"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1-.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21H19v-5.3c0-1.27-.02-2.9-1.77-2.9-1.77 0-2.04 1.38-2.04 2.8V21H9z"/></svg></a>
            <a class="share__btn share__btn--x" data-share="x" href="#" target="_blank" rel="noopener" aria-label="Share on X"><svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M18.9 3H22l-7.1 8.1L23 21h-6.6l-5.2-6.8L5.2 21H2l7.6-8.7L1.5 3h6.8l4.7 6.2zm-1.1 16.2h1.7L7.3 4.7H5.5z"/></svg></a>
            <a class="share__btn share__btn--email" data-share="email" href="#" aria-label="Share by email"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></a>
            <button class="share__btn share__btn--copy" type="button" data-copy aria-label="Copy link"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg></button>
            <span class="share__copied" hidden>Link copied</span>
            <a class="share__google" href="https://www.google.com/preferences/source?q=theceochannel.com" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="14" height="14"><path fill="#4285F4" d="M22 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.6a4.8 4.8 0 0 1-2.1 3.1v2.6h3.4c2-1.8 3.1-4.5 3.1-7.5z"/><path fill="#34A853" d="M12 22c2.8 0 5.2-.9 6.9-2.5l-3.4-2.6c-.9.6-2.1 1-3.5 1-2.7 0-5-1.8-5.8-4.3H2.7v2.7A10 10 0 0 0 12 22z"/><path fill="#FBBC05" d="M6.2 13.6a6 6 0 0 1 0-3.8V7.1H2.7a10 10 0 0 0 0 9.2z"/><path fill="#EA4335" d="M12 6c1.5 0 2.9.5 4 1.5l3-3A10 10 0 0 0 2.7 7.1l3.5 2.7C7 7.8 9.3 6 12 6z"/></svg>
              Add The CEO Channel on Google
            </a>
          </div>
        </div>
      </header>

      <!-- PHOTO 1 of 7 — main photo, full width -->
      {% if a.lead %}
      <figure class="article__lead photo">
        <img src="{{ a.lead.src }}" alt="{{ a.lead.alt }}" style="object-position: {{ a.lead.position }}" referrerpolicy="no-referrer" />
        {% if a.lead.caption or a.lead.credit %}<figcaption>{{ a.lead.caption }}{% if a.lead.credit %} (Photo: {{ a.lead.credit }}){% endif %}</figcaption>{% endif %}
      </figure>
      {% endif %}

      <!-- RELATED — four stories with thumbnails, under the header and main photo -->
      {% if a.related.length %}
      <section class="related wrap" data-pagefind-ignore>
        <div class="section__head"><h2 class="section__heading">Related</h2></div>
        <div class="related__list">
          {% for r in a.related.slice(0, 4) %}
          <a class="related__item" href="{{ r.url }}">
            {% if r.image %}<span class="media media--card"><img src="{{ r.image }}" style="object-position: {{ r.imagePosition }}" width="240" height="180" alt="" referrerpolicy="no-referrer" loading="lazy" /></span>{% endif %}
            <span class="related__title">{{ r.title }}</span>
          </a>
          {% endfor %}
        </div>
      </section>
      {% endif %}

      <!-- BODY — one centred reading column; photos 2–7, pull quote,
           Instagram and a newsletter box slotted in -->
      <div class="article__body wrap">
        <div class="article__main article__main--magazine">
          {% for part in a.parts %}
            {% if part.type == "html" %}{{ part.html | safe }}
            {% elif part.type == "photo" %}{{ figure(part.photo) }}
            {% elif part.type == "quote" %}<blockquote class="pullquote">“{{ part.text }}”</blockquote>
            {% elif part.type == "pair" %}
            <div class="photo-pair">
              {% if part.left %}{{ figure(part.left) }}{% endif %}
              {% if part.right %}{{ figure(part.right) }}{% endif %}
            </div>
            {% elif part.type == "instagram" %}<figure class="insta">{{ part.html | safe }}</figure>
            {% elif part.type == "newsletter" %}
            <aside class="inline-subscribe" data-pagefind-ignore>
              <p class="inline-subscribe__title">Sharpen your game</p>
              <p>Subscribe to our newsletter for the latest interviews, insights and industry opinions delivered straight to your inbox.</p>
              {{ subscribeForm(cms.site, "article") }}
            </aside>
            {% endif %}
          {% endfor %}

          <!-- KEYWORDS — each opens a page of every story with that keyword -->
          {% if a.keywords.length %}
          <div class="keywords" data-pagefind-ignore>
            <span class="keywords__label">Keywords</span>
            {% for k in a.keywordLinks %}<a class="keywords__item" href="{{ k.url }}">{{ k.name }}</a>{% endfor %}
          </div>
          {% endif %}

          <!-- PEOPLE IN THIS STORY — links to their C-Suite profile pages -->
          {% if a.people.length %}
          <div class="people" data-pagefind-ignore>
            {% for c in a.people %}
            <a class="people__item" href="{{ c.url }}">
              <span class="media media--tall people__pic">{% if c.portrait %}<img src="{{ c.portrait }}" style="object-position: {{ c.portraitPosition }}" alt="" referrerpolicy="no-referrer" loading="lazy" />{% else %}<span class="portrait__initials" aria-hidden="true">{{ c.initials }}</span>{% endif %}</span>
              <span><span class="tag">In this story</span><span class="people__name">{{ c.name }}</span><span class="people__role">{{ c.role }}, {{ c.companyName }}</span><span class="people__link">View profile</span></span>
            </a>
            {% endfor %}
          </div>
          {% endif %}

          <p class="meta article__end" data-pagefind-ignore>Published {{ a.publishedText }}{% if a.updatedText %} &nbsp;·&nbsp; Updated {{ a.updatedText }}{% endif %}</p>

          <div class="ad ad--rectangle" role="complementary" aria-label="Advertisement" data-pagefind-ignore>
            <span class="ad__label">AD — MEDIUM RECTANGLE 300x250</span>
          </div>
        </div>
      </div>
    </article>

    <!-- RECOMMENDED — the next four from the related list, with pictures -->
    {% set rec = a.related.slice(4, 8) %}
    {% if not rec.length %}{% set rec = a.related.slice(0, 4) %}{% endif %}
    <section class="wrap section">
      <div class="section__head"><h2 class="section__heading">Recommended</h2></div>
      <div class="grid grid--4">
        {% for r in rec %}
        <article class="card">
          {% if r.image %}<a class="media media--card" href="{{ r.url }}"><img src="{{ r.image }}" style="object-position: {{ r.imagePosition }}" width="600" height="450" alt="" referrerpolicy="no-referrer" loading="lazy" /></a>{% endif %}
          <p class="{{ 'sponsored' if r.sponsored else 'tag' }}">{{ r.label }}</p>
          <h3 class="card__title"><a href="{{ r.url }}">{{ r.title }}</a></h3>
        </article>
        {% endfor %}
      </div>
    </section>
