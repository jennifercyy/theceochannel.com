---
layout: layouts/base.njk
permalink: /index.html
---
{#
  HOMEPAGE. Everything here is chosen in the editor under “Homepage”.
  Each section has a “Show …” switch there; switched-off sections
  are skipped below by the {% if … .show %} lines.
#}
{% set h = cms.home %}

    <!-- 1. LEAD STORIES (CNA format) — main story + three beside it -->
    {% if h.lead %}
    <section class="wrap lead">
      <article class="lead__main">
        <a class="media media--wide" href="{{ h.lead.url }}"><img src="{{ h.lead.image }}" width="1400" height="788" alt="{{ h.lead.photo1.alt }}" referrerpolicy="no-referrer" /></a>
        <p class="{{ 'sponsored' if h.lead.sponsored else 'tag' }}">{{ h.lead.label }}</p>
        <h1 class="lead__headline"><a href="{{ h.lead.url }}">{{ h.lead.title }}</a></h1>
        <p class="lead__standfirst">{{ h.lead.excerpt }}</p>
      </article>

      <div class="lead__side">
        {% for a in h.secondary %}
        <article class="lead__side-item">
          {% if loop.first and a.image %}<a class="media media--wide" href="{{ a.url }}"><img src="{{ a.image }}" width="700" height="394" alt="" referrerpolicy="no-referrer" /></a>{% endif %}
          <p class="{{ 'sponsored' if a.sponsored else 'tag' }}">{{ a.label }}</p>
          <h2 class="card__title"><a href="{{ a.url }}">{{ a.title }}</a></h2>
        </article>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <!-- 2. LATEST INTERVIEWS — newest three stories of type Interview -->
    {% if h.latestInterviews.show %}
    <section class="wrap section" id="interviews" style="padding-top:0">
      <div class="section__head">
        <h2 class="section__heading">Latest interviews</h2>
      </div>
      <div class="grid grid--3">
        {% for a in h.latestInterviews.items %}
        <article class="card">
          <a class="media media--card" href="{{ a.url }}"><img src="{{ a.image }}" width="800" height="600" alt="" referrerpolicy="no-referrer" /></a>
          <p class="{{ 'sponsored' if a.sponsored else 'tag' }}">{{ a.label }}</p>
          <h3 class="card__title"><a href="{{ a.url }}">{{ a.title }}</a></h3>
          <p class="meta">{{ a.date }}</p>
        </article>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <!-- 3. CEO SPOTLIGHT — dark band; each CEO lists their stories -->
    {% if h.spotlight.show and h.spotlight.items.length %}
    <section class="spotlight" id="spotlight">
      <div class="wrap section">
        <div class="section__head">
          <h2 class="section__heading">CEO Spotlight</h2>
        </div>
        {% if h.spotlight.intro %}<p class="spotlight__intro">{{ h.spotlight.intro }}</p>{% endif %}
        <div class="grid grid--4">
          {% for c in h.spotlight.items %}
          <article class="ceo">
            <a class="media media--tall" href="{{ c.url }}"><img src="{{ c.portrait }}" width="600" height="750" alt="{{ c.name }}" referrerpolicy="no-referrer" /></a>
            <div>
              <h3 class="ceo__name"><a href="{{ c.url }}">{{ c.name }}</a></h3>
              <p class="ceo__role">{{ c.role }}, {{ c.companyName }}</p>
            </div>
            <ul class="ceo__stories">
              {% for a in c.stories.slice(0, 3) %}
              <li><span class="tag">{{ a.storyLabel or a.format }}</span><a href="{{ a.url }}">{{ a.title }}</a></li>
              {% endfor %}
            </ul>
          </article>
          {% endfor %}
        </div>
      </div>
    </section>
    {% endif %}

    <!-- 4. PICTURE SECTION — Tatler Homes photo placement:
            one tall picture left; one wide + two small right -->
    {% set ps = h.photoSection %}
    {% if ps.show and ps.items.length %}
    <section class="wrap section" id="pictures">
      <div class="section__head">
        <h2 class="section__heading">{{ ps.heading or ps.cat.name }}</h2>
      </div>

      <div class="tatler">
        {% set a = ps.items[0] %}
        <article class="tatler__tall">
          <a class="media media--tall" href="{{ a.url }}"><img src="{{ a.image }}" width="800" height="1000" alt="" referrerpolicy="no-referrer" /></a>
          <p class="{{ 'sponsored' if a.sponsored else 'tag' }}">{{ a.label }}</p>
          <h3 class="tatler__title"><a href="{{ a.url }}">{{ a.title }}</a></h3>
          <p class="tatler__excerpt">{{ a.excerpt }}</p>
        </article>

        <div class="tatler__side">
          {% if ps.items[1] %}{% set a = ps.items[1] %}
          <article class="tatler__wide">
            <a class="media media--wide" href="{{ a.url }}"><img src="{{ a.image }}" width="800" height="450" alt="" referrerpolicy="no-referrer" /></a>
            <p class="{{ 'sponsored' if a.sponsored else 'tag' }}">{{ a.label }}</p>
            <h3 class="card__title"><a href="{{ a.url }}">{{ a.title }}</a></h3>
          </article>
          {% endif %}
          <div class="tatler__pair">
            {% for a in ps.items.slice(2, 4) %}
            <article class="tatler__small">
              <a class="media media--card" href="{{ a.url }}"><img src="{{ a.image }}" width="400" height="300" alt="" referrerpolicy="no-referrer" /></a>
              <p class="{{ 'sponsored' if a.sponsored else 'tag' }}">{{ a.label }}</p>
              <h3 class="tatler__small-title"><a href="{{ a.url }}">{{ a.title }}</a></h3>
            </article>
            {% endfor %}
          </div>
        </div>
      </div>

      {% if ps.cat %}<a class="more-link" href="{{ ps.cat.url }}">More {{ (ps.heading or ps.cat.name) | lower }} →</a>{% endif %}
    </section>
    {% endif %}

    <!-- 5. VIDEO / PARTNER CONTENT -->
    {% set v = h.video.item %}
    {% if h.video.show and v %}
    <section class="partner-video" id="video">
      <div class="wrap section partner-video__inner">
        <a class="video" href="{{ v.videoUrl or '#' }}" target="_blank" rel="noopener" aria-label="Play video">
          <img src="{{ v.thumbnail }}" width="1200" height="675" alt="" referrerpolicy="no-referrer" />
          <span class="video__play"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
          {% if v.duration %}<span class="video__time">{{ v.duration }}</span>{% endif %}
        </a>
        <div>
          {% if v.sponsored %}<p class="sponsored">Partner content{% if v.sponsorName %} · {{ v.sponsorName }}{% endif %}</p>{% endif %}
          <h2 class="partner-video__title">{{ v.title }}</h2>
          <p>{{ v.description }}</p>
          <a class="quiet-link" href="#footer">Partner with us</a>
        </div>
      </div>
    </section>
    {% endif %}

    <!-- 6. FEATURE BAND — grey panel (Tatler Homes Design Awards placement):
            heading + description left, three stories with pictures right -->
    {% set fb = h.featureBand %}
    {% if fb.show and fb.items.length %}
    <section class="wrap section" id="feature">
      <div class="feature-band">
        <div class="feature-band__intro">
          <h2 class="feature-band__heading">{{ fb.heading }}</h2>
          <span class="feature-band__bar" aria-hidden="true"></span>
          <p>{{ fb.description }}</p>
          {% if fb.viewAllCat %}<a class="more-link more-link--left" href="{{ fb.viewAllCat.url }}">View all →</a>{% endif %}
        </div>
        <ul class="feature-band__list">
          {% for a in fb.items %}
          <li>
            <a class="media media--card" href="{{ a.url }}"><img src="{{ a.image }}" width="300" height="225" alt="" referrerpolicy="no-referrer" /></a>
            <div>
              <p class="{{ 'sponsored' if a.sponsored else 'tag' }}">{{ a.label }}</p>
              <h3 class="tatler__small-title"><a href="{{ a.url }}">{{ a.title }}</a></h3>
            </div>
          </li>
          {% endfor %}
        </ul>
      </div>
    </section>
    {% endif %}

    <!-- 7. LIST SECTION — thumbnail + text rows, ad space alongside -->
    {% set ins = h.insights %}
    {% if ins.show and ins.items.length %}
    <section class="wrap section band" id="insights">
      <div>
        <div class="section__head">
          <h2 class="section__heading">{{ ins.heading or ins.cat.name }}</h2>
          {% if ins.cat %}<a class="section__more" href="{{ ins.cat.url }}">See all</a>{% endif %}
        </div>
        <ul class="rows">
          {% for a in ins.items %}
          <li>
            <a class="media media--card" href="{{ a.url }}"><img src="{{ a.image }}" width="500" height="375" alt="" referrerpolicy="no-referrer" /></a>
            <div>
              <p class="{{ 'sponsored' if a.sponsored else 'tag' }}">{{ a.label }}</p>
              <h3 class="card__title"><a href="{{ a.url }}">{{ a.title }}</a></h3>
              <p class="rows__excerpt">{{ a.excerpt }}</p>
              <p class="meta">{{ a.date }}</p>
            </div>
          </li>
          {% endfor %}
        </ul>
      </div>

      <aside class="band__aside">
        <div class="ad ad--halfpage" role="complementary" aria-label="Advertisement">
          <span class="ad__label">AD — HALF PAGE 300x600</span>
        </div>
      </aside>
    </section>
    {% endif %}

    <!-- 8. NEWSLETTER SIGNUP -->
    {% if h.newsletter.show %}
    <section class="newsletter">
      <div class="wrap newsletter__inner">
        <div class="section__head"><h2 class="section__heading">The weekly briefing</h2></div>
        <p class="newsletter__lead">One email each Friday: the interview of the week, and the three business stories that will matter on Monday.</p>
        <form class="newsletter__form" action="#" method="post" onsubmit="return false;">
          <label class="visually-hidden" for="email">Email address</label>
          <input type="email" id="email" name="email" placeholder="you@company.com" required />
          <button type="submit">Subscribe</button>
        </form>
      </div>
    </section>
    {% endif %}
