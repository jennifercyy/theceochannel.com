---
layout: layouts/base.njk
permalink: /index.html
---
{#
  HOMEPAGE. Everything here is chosen in the editor under “Homepage”.
  The sections are drawn in the order Jamie drags them into there;
  hidden ones never reach this page.
#}
{% from "partials/subscribe.njk" import subscribeForm %}
{% set h = cms.home %}

{# A story's picture, if it has one. `ratio` is a media-- class. #}
{% macro pic(a, ratio, w, ht) %}{% if a.image %}<a class="media media--{{ ratio }}" href="{{ a.url }}"><img src="{{ a.image }}" style="object-position: {{ a.imagePosition }}" width="{{ w }}" height="{{ ht }}" alt="" referrerpolicy="no-referrer" loading="lazy" /></a>{% endif %}{% endmacro %}
{# A person's portrait, or a grey panel with their initials until one is uploaded #}
{% macro portrait(c, w, ht) %}<a class="media media--tall portrait" href="{{ c.url }}">{% if c.portrait %}<img src="{{ c.portrait }}" style="object-position: {{ c.portraitPosition }}" width="{{ w }}" height="{{ ht }}" alt="{{ c.name }}" referrerpolicy="no-referrer" loading="lazy" />{% else %}<span class="portrait__initials" aria-hidden="true">{{ c.initials }}</span>{% endif %}</a>{% endmacro %}
{% macro label(a) %}<p class="{{ 'sponsored' if a.sponsored else 'tag' }}">{{ a.label }}</p>{% endmacro %}
{% macro head(sec) %}
      <div class="section__head">
        <h2 class="section__heading">{{ sec.heading }}</h2>
        {% if sec.moreUrl %}<a class="section__more" href="{{ sec.moreUrl }}">More</a>{% endif %}
      </div>
{% endmacro %}

    <!-- LEAD STORY — full-width picture; under it, the headline on the
         left and the three other top stories stacked on the right -->
    {% if h.lead %}
    <section class="wrap lead">
      {{ pic(h.lead, "wide", 1600, 686) }}
      <div class="lead__row">
        <article class="lead__main">
          {{ label(h.lead) }}
          <h1 class="lead__headline"><a href="{{ h.lead.url }}">{{ h.lead.title }}</a></h1>
          <p class="lead__standfirst">{{ h.lead.excerpt }}</p>
        </article>
        {% if h.secondary.length %}
        <div class="lead__side">
          {% for a in h.secondary %}
          <article class="lead__side-item">
            {{ pic(a, "card", 240, 180) }}
            <div>
              {{ label(a) }}
              <h2 class="lead__side-title"><a href="{{ a.url }}">{{ a.title }}</a></h2>
            </div>
          </article>
          {% endfor %}
        </div>
        {% endif %}
      </div>
    </section>
    {% endif %}

{% for sec in h.sections %}

  {% if sec.type == "stories" and sec.layout == "grid" %}
    <!-- GRID — three cards in a row -->
    <section class="wrap section" {% if sec.slug %}id="{{ sec.slug }}"{% endif %}>
      {{ head(sec) }}
      <div class="grid grid--3">
        {% for a in sec.items %}
        <article class="card">
          {{ pic(a, "card", 800, 600) }}
          {{ label(a) }}
          <h3 class="card__title"><a href="{{ a.url }}">{{ a.title }}</a></h3>
          <p class="meta">{{ a.date }}</p>
        </article>
        {% endfor %}
      </div>
    </section>

  {% elif sec.type == "stories" and sec.layout == "pictures" %}
    <!-- PICTURES — Tatler Homes photo placement:
         one tall picture left; one wide + two small right -->
    <section class="wrap section" {% if sec.slug %}id="{{ sec.slug }}"{% endif %}>
      {{ head(sec) }}
      <div class="tatler">
        {% set a = sec.items[0] %}
        <article class="tatler__tall">
          {{ pic(a, "tall", 800, 1000) }}
          {{ label(a) }}
          <h3 class="tatler__title"><a href="{{ a.url }}">{{ a.title }}</a></h3>
          <p class="tatler__excerpt">{{ a.excerpt }}</p>
        </article>
        <div class="tatler__side">
          {% if sec.items[1] %}{% set a = sec.items[1] %}
          <article class="tatler__wide">
            {{ pic(a, "wide", 800, 450) }}
            {{ label(a) }}
            <h3 class="card__title"><a href="{{ a.url }}">{{ a.title }}</a></h3>
          </article>
          {% endif %}
          <div class="tatler__pair">
            {% for a in sec.items.slice(2, 4) %}
            <article class="tatler__small">
              {{ pic(a, "card", 400, 300) }}
              {{ label(a) }}
              <h3 class="tatler__small-title"><a href="{{ a.url }}">{{ a.title }}</a></h3>
            </article>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>

  {% elif sec.type == "stories" and sec.layout == "band" %}
    <!-- GREY BAND (Tatler Homes Design Awards placement):
         heading + description left, three picture rows right -->
    <section class="wrap section" {% if sec.slug %}id="{{ sec.slug }}"{% endif %}>
      <div class="feature-band">
        <div class="feature-band__intro">
          <h2 class="feature-band__heading">{{ sec.heading }}</h2>
          <span class="feature-band__bar" aria-hidden="true"></span>
          {% if sec.description %}<p>{{ sec.description }}</p>{% endif %}
          {% if sec.moreUrl %}<a class="more-link more-link--left" href="{{ sec.moreUrl }}">More</a>{% endif %}
        </div>
        <ul class="feature-band__list">
          {% for a in sec.items %}
          <li>
            {% if a.image %}{{ pic(a, "card", 300, 225) }}{% else %}<span></span>{% endif %}
            <div>
              {{ label(a) }}
              <h3 class="tatler__small-title"><a href="{{ a.url }}">{{ a.title }}</a></h3>
            </div>
          </li>
          {% endfor %}
        </ul>
      </div>
    </section>

  {% elif sec.type == "stories" and sec.layout == "list" %}
    <!-- LIST — thumbnail + text rows, ad space alongside -->
    <section class="wrap section band" {% if sec.slug %}id="{{ sec.slug }}"{% endif %}>
      <div>
        {{ head(sec) }}
        <ul class="rows">
          {% for a in sec.items %}
          <li>
            {% if a.image %}{{ pic(a, "card", 500, 375) }}{% else %}<span></span>{% endif %}
            <div>
              {{ label(a) }}
              <h3 class="card__title"><a href="{{ a.url }}">{{ a.title }}</a></h3>
              <p class="rows__excerpt">{{ a.excerpt }}</p>
              <p class="meta">{{ a.date }}</p>
            </div>
          </li>
          {% endfor %}
        </ul>
      </div>
      <aside class="band__aside">
        <div class="ad ad--halfpage" role="complementary" aria-label="Advertisement">
          <span class="ad__label">AD — HALF PAGE 300x600</span>
        </div>
      </aside>
    </section>

  {% elif sec.type == "csuite" %}
    {% set c = sec.person %}
    <!-- C-SUITE FEATURE — grey band: big portrait of the featured person
         left, with their short bio and the stories that mention them;
         the newest other stories from the section on the right -->
    <section class="wrap section" {% if sec.slug %}id="{{ sec.slug }}"{% endif %}>
      <div class="csuite">
        <div class="csuite__head">
          <h2 class="feature-band__heading">{{ sec.heading }}</h2>
          <span class="feature-band__bar" aria-hidden="true"></span>
        </div>
        <div class="csuite__person">
          {{ portrait(c, 900, 1125) }}
          <div class="csuite__info">
            {% if c.sponsored %}<p class="sponsored">Partner feature</p>{% else %}<p class="tag">C-Suite profile</p>{% endif %}
            <h3 class="csuite__name"><a href="{{ c.url }}">{{ c.name }}</a></h3>
            <p class="csuite__role">{{ c.role }}, {{ c.companyName }}</p>
            {% if c.shortBio %}<p class="csuite__bio">{{ c.shortBio }}</p>{% endif %}
            {% if c.stories.length %}
            <ul class="csuite__stories">
              {% for a in c.stories.slice(0, 3) %}<li><span class="tag">{{ a.storyLabel or a.format }}</span><a href="{{ a.url }}">{{ a.title }}</a></li>{% endfor %}
            </ul>
            {% endif %}
            <a class="more-link more-link--left" href="{{ c.url }}">Full profile</a>
          </div>
        </div>
        <div class="csuite__side">
          <p class="csuite__side-label">Latest</p>
          <ul class="feature-band__list">
            {% for a in sec.items %}
            <li>
              {% if a.image %}{{ pic(a, "card", 300, 225) }}{% else %}<span></span>{% endif %}
              <div>
                {{ label(a) }}
                <h3 class="tatler__small-title"><a href="{{ a.url }}">{{ a.title }}</a></h3>
              </div>
            </li>
            {% endfor %}
          </ul>
          {% if sec.moreUrl %}<a class="more-link more-link--left" href="{{ sec.moreUrl }}">More</a>{% endif %}
        </div>
      </div>
    </section>

  {% elif sec.type == "spotlight" %}
    <!-- CEO SPOTLIGHT — dark band; each CEO lists their stories -->
    <section class="spotlight">
      <div class="wrap section">
        <div class="section__head"><h2 class="section__heading">{{ sec.heading }}</h2></div>
        {% if sec.intro %}<p class="spotlight__intro">{{ sec.intro }}</p>{% endif %}
        <div class="grid grid--4">
          {% for c in sec.items %}
          <article class="ceo">
            {{ portrait(c, 600, 750) }}
            <div>
              <h3 class="ceo__name"><a href="{{ c.url }}">{{ c.name }}</a></h3>
              <p class="ceo__role">{{ c.role }}, {{ c.companyName }}</p>
            </div>
            <ul class="ceo__stories">
              {% for a in c.stories.slice(0, 3) %}
              <li><span class="tag">{{ a.storyLabel or a.format }}</span><a href="{{ a.url }}">{{ a.title }}</a></li>
              {% endfor %}
            </ul>
          </article>
          {% endfor %}
        </div>
      </div>
    </section>

  {% elif sec.type == "video" %}
    {% set v = sec.item %}
    <!-- VIDEO -->
    <section class="partner-video">
      <div class="wrap section partner-video__inner">
        <a class="video" href="{{ v.videoUrl or '#' }}" target="_blank" rel="noopener" aria-label="Play video">
          <img src="{{ v.thumbnail }}" width="1200" height="675" alt="" referrerpolicy="no-referrer" loading="lazy" />
          <span class="video__play"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
          {% if v.duration %}<span class="video__time">{{ v.duration }}</span>{% endif %}
        </a>
        <div>
          {% if v.sponsored %}<p class="sponsored">Partner content{% if v.sponsorName %} · {{ v.sponsorName }}{% endif %}</p>{% endif %}
          <h2 class="partner-video__title">{{ v.title }}</h2>
          <p>{{ v.description }}</p>
        </div>
      </div>
    </section>

  {% elif sec.type == "newsletter" %}
    <!-- NEWSLETTER SIGN-UP -->
    <section class="newsletter">
      <div class="wrap newsletter__inner">
        <div class="section__head"><h2 class="section__heading">Sharpen your game</h2></div>
        <p class="newsletter__lead">Subscribe to our newsletter for the latest interviews, insights and industry opinions delivered straight to your inbox.</p>
        {{ subscribeForm(cms.site, "home") }}
      </div>
    </section>
  {% endif %}

{% endfor %}
